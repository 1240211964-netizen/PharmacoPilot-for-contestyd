{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pharmacopilot.local/schemas/v1/model-run.schema.json",
  "title": "ModelRun",
  "description": "模型运行记录:一次工作流中模型调用的输入/输出/状态审计。空值策略:可选字段默认省略而非 null;仅 type 标注 [\"...\",\"null\"] 的字段允许 null。tokenUsage 为 nullable,不假设本地模型都返回用量。自包含,不使用 $ref。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelRunId",
    "schemaVersion",
    "workflowId",
    "agentId",
    "provider",
    "model",
    "thinkingMode",
    "reasoningEffort",
    "promptVersion",
    "inputRecordIds",
    "evidenceIds",
    "inputHash",
    "outputHash",
    "rawOutputLocation",
    "structuredOutput",
    "latencyMs",
    "tokenUsage",
    "validationStatus",
    "fallbackUsed",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "modelRunId": {
      "type": "string",
      "pattern": "^mrn_[A-Za-z0-9]{8,64}$"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^wf_[A-Za-z0-9]{8,64}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agt_[a-z0-9-]{2,64}$"
    },
    "provider": {
      "enum": ["mock", "existing-mlx", "deepseek-cloud"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "thinkingMode": {
      "type": ["string", "null"],
      "enum": ["on", "off", "auto", null],
      "description": "nullable:模型不支持思考模式开关时为 null。"
    },
    "reasoningEffort": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null],
      "description": "nullable:模型不支持推理强度档位时为 null。"
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputRecordIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev_[A-Za-z0-9]{8,64}$"
      }
    },
    "inputHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outputHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "nullable:运行失败无输出时为 null。"
    },
    "rawOutputLocation": {
      "type": ["string", "null"],
      "description": "nullable:原始输出落盘位置,未保留时为 null。"
    },
    "structuredOutput": {
      "type": ["object", "null"],
      "description": "nullable:解析出的结构化输出,失败或未解析时为 null。"
    },
    "latencyMs": {
      "type": ["number", "null"],
      "description": "nullable:调用未完成或无计时时为 null。"
    },
    "tokenUsage": {
      "type": ["object", "null"],
      "description": "nullable:不假设本地模型都返回 token 用量,缺失时为 null。",
      "additionalProperties": false,
      "required": ["promptTokens", "completionTokens", "totalTokens"],
      "properties": {
        "promptTokens": { "type": "number" },
        "completionTokens": { "type": "number" },
        "totalTokens": { "type": "number" }
      }
    },
    "validationStatus": {
      "enum": ["PENDING", "PASSED", "FAILED", "WARNING", "NOT_APPLICABLE"]
    },
    "fallbackUsed": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "nullable:运行尚未结束时为 null。"
    }
  }
}
